{
  "name": "bills",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-site.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#241A17\" --iconBackgroundColorDark \"#241A17\" --splashBackgroundColor \"#FFF8F0\" --splashBackgroundColorDark \"#241A17\" && node scripts/patch-adaptive-icon.mjs && node scripts/check-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "worker:dev": "wrangler dev --config server/wrangler.toml",
    "worker:deploy": "wrangler deploy --config server/wrangler.toml",
    "build:native": "cross-env BILLS_NATIVE=1 tsc -b && cross-env BILLS_NATIVE=1 vite build",
    "sync": "npm run build:native && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets:check": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
